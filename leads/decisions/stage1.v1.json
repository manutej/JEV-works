{
  "positive": "admit the lead to stage 2 (a real, parseable lead)",
  "thresholds": { "yes": 0.85, "no": 0.15 },
  "rules": [
    { "when": { "any": [
        { "q": "isRealBusiness", "is": "no" },
        { "q": "hasNamedCompany", "is": "no" },
        { "q": "senderWroteASentence", "is": "no" },
        { "q": "onTopicParseable", "is": "no" },
        { "q": "isEmptyOrMarkup", "is": "yes" } ] }, "then": false },
    { "when": { "all": [
        { "q": "hasNamedCompany", "is": "yes" },
        { "q": "senderWroteASentence", "is": "yes" },
        { "q": "onTopicParseable", "is": "yes" },
        { "q": "isEmptyOrMarkup", "is": "no" } ] }, "then": true }
  ],
  "default": "escalate"
}
